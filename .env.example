# ConvertFlow — Environment variables
# Copy this file to .env and fill in your values.

# Database (SQLite for local dev — switch to PostgreSQL/Neon for production)
DATABASE_URL="file:./dev.db"

# For Neon PostgreSQL production:
# DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/convertflow?sslmode=require"

# Cloudinary (image storage & optimization) — optional
# CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# Resend (transactional emails) — optional
# RESEND_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
